# 当前文件只放示例占位符，不要填写真实密钥。
# 公开变量可以进入浏览器；服务器Secret key绝对不能使用 NEXT_PUBLIC 前缀。

NEXT_PUBLIC_APP_NAME="AI视频生成平台"
NEXT_PUBLIC_APP_MODE=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Local single-user lab mode. NEXT_PUBLIC_APP_MODE only affects browser display;
# LOCAL_LAB_ENABLED is server-only and enables loopback-only protection plus local auto login.
LOCAL_LAB_ENABLED=""

# 优先使用 Supabase 新版 Secret key。旧 service_role key 只作为兼容后备。
SUPABASE_SECRET_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# 本地模拟Worker可选配置。
MOCK_VIDEO_SOURCE=""
MOCK_WORKER_POLL_INTERVAL_MS=""
MOCK_WORKER_ONCE=""

# GPU Worker limited account. These values are generated into .secrets/gpu-worker.env,
# not committed here.
GPU_WORKER_EMAIL=""
GPU_WORKER_PASSWORD=""
GPU_WORKER_USER_ID=""

# Wan2.2 GPU worker runtime.
WAN_RUNNER="mock"
WAN_MODEL_REVISION="921dbaf3f1674a56f47e83fb80a34bac8a8f203e"
WAN_CODE_REVISION="42bf4cfaa384bc21833865abc2f9e6c0e67233dc"
WAN_MODEL_DIR="/workspace/models/Wan2.2-TI2V-5B"
WAN_OUTPUT_DIR="/workspace/jobs"
WAN_WIDTH="1280"
WAN_HEIGHT="704"
WAN_NUM_FRAMES="120"
WAN_INFERENCE_STEPS="30"
WAN_GUIDANCE_SCALE="5"
WAN_SEED="42"
WAN_CPU_OFFLOAD="true"
WORKER_POLL_INTERVAL_SECONDS="8"
WORKER_LEASE_SECONDS="300"
FIRST_SESSION_MAX_CLAIMS="1"

# Clore local-only rental planning. Put real CLORE_API_KEY only in .secrets/clore.env.
CLORE_API_KEY=""
CLORE_MAX_GPU_PRICE_PER_HOUR="0.70"
CLORE_MIN_RELIABILITY="0.99"
CLORE_MIN_RATING="4.7"
CLORE_MIN_RATING_COUNT="3"
CLORE_MIN_RAM_GB="64"
CLORE_MIN_CPU_CORES="8"
CLORE_MIN_DISK_GB="200"
CLORE_MIN_DOWNLOAD_MBPS="300"
CLORE_MIN_UPLOAD_MBPS="100"
CLORE_MIN_RENTAL_HOURS="6"
CLORE_ALLOWED_COUNTRIES=""
CLORE_RENTAL_CURRENCY="USD-Blockchain"
CLORE_DOCKER_IMAGE=""
CLORE_ORDER_TYPE="on-demand"
CLORE_SSH_PUBLIC_KEY_PATH=""
CLORE_PROJECT_TAG="ai-video-platform-wan22"

# Cost-optimized GPU session planning.
GPU_PRICE_USD_PER_HOUR="0.70"
GPU_SESSION_HOURS="6"
GPU_COLD_START_MINUTES="60"
GPU_WARM_START_MINUTES="15"
GPU_HARD_SESSION_LIMIT_MINUTES="380"
GPU_MONTHLY_SESSIONS="2"
CLORE_BALANCE_USD="11"
CLORE_RESERVE_USD="1"
CLORE_VOLUME_MINUTES_SAVED_PER_SESSION="10"

# Private model cache placeholders. Put real values only in .secrets/model-cache.env.
MODEL_CACHE_PROVIDER="r2"
MODEL_CACHE_BUCKET=""
MODEL_CACHE_PREFIX="wan22-ti2v-5b"
MODEL_CACHE_ENDPOINT=""
MODEL_CACHE_REGION="auto"
MODEL_CACHE_READ_ONLY="true"
MODEL_CACHE_LOCAL_DIR="/workspace/models/Wan2.2-TI2V-5B"
MODEL_CACHE_VOLUME_DIR="/workspace/model-cache/Wan2.2-TI2V-5B"
MODEL_CACHE_R2_ENABLED="true"
MODEL_CACHE_HF_FALLBACK_ENABLED="true"
MODEL_CACHE_ACCESS_KEY_ID=""
MODEL_CACHE_SECRET_ACCESS_KEY=""
WAN_MODEL_REPO="Wan-AI/Wan2.2-TI2V-5B"
WAN_MODEL_EXPECTED_SIZE_GB="34.2"
MODEL_CACHE_PRESIGN_EXPIRES_SECONDS="7200"
MODEL_CACHE_SMALL_PUT_THRESHOLD_BYTES="8388608"
MODEL_CACHE_MULTIPART_THRESHOLD_BYTES="16777216"
MODEL_CACHE_SEED_TEST_PREFIX="wan22-ti2v-5b/_seed-test"

# Local media root. Leave blank to use <repository root>\\local-data.
# The legacy library variables are read-only fallbacks and never receive new assets.
LOCAL_DATA_ROOT=""
LOCAL_IMAGE_LIBRARY_DIR="D:\\AI-Creative-Library"
LOCAL_VIDEO_LIBRARY_DIR="D:\\AI-Video-Library"
LOCAL_RESULTS_MIN_REMOTE_RETENTION_HOURS="24"

# Local-lab Clore web console. Keep these server-only; never add NEXT_PUBLIC_CLORE_*.
CLORE_ORDER_EXECUTION_ENABLED="false"
CLORE_AUTORENT_ENABLED="false"
CLORE_FIRST_GPU_SESSION="true"
CLORE_FIRST_SESSION_MAX_BUDGET_USD="4.50"
CLORE_BALANCE_RESERVE_USD="1.00"
CLORE_HARD_SESSION_LIMIT_MINUTES="380"
CLORE_ORDER_START_TIMEOUT_MINUTES="15"
CLORE_WORKER_READY_TIMEOUT_MINUTES="120"
CLORE_CANDIDATE_REFRESH_SECONDS="60"
CLORE_ORDER_PLAN_TTL_SECONDS="120"
CLORE_IDLE_SHUTDOWN_MINUTES="15"
CLORE_AUTO_SHUTDOWN_ENABLED="false"
