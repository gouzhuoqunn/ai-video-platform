{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-video-platform/benchmark-plan.schema.json",
  "title": "AI Video Platform Benchmark Plan",
  "type": "object",
  "required": ["schemaVersion", "suiteVersion", "candidateKey", "gpuProfile", "workflowKey", "sampleIds", "stage", "timeoutSeconds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suiteVersion": { "const": "v1" },
    "candidateKey": { "type": "string", "minLength": 1 },
    "gpuProfile": { "enum": ["rtx4090", "rtx5090"] },
    "workflowKey": { "enum": ["image_t2i", "video_ti2v", "video_i2v", "video_flf2v"] },
    "sampleIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "stage": { "enum": ["smoke", "quality"] },
    "runsPerSample": { "type": "integer", "minimum": 1 },
    "timeoutSeconds": { "type": "integer", "minimum": 1 },
    "requiresHumanApprovalBeforeProduction": { "const": true },
    "mayReadBenchmarkStagingOnly": { "type": "boolean" }
  },
  "additionalProperties": false
}
