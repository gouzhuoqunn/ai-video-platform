{
  "name": "ai-video-platform",
  "private": true,
  "version": "0.1.0",
  "description": "AI视频生成平台前端演示版",
  "scripts": {
    "dev": "next dev",
    "dev:local": "cross-env NEXT_PUBLIC_APP_MODE=local_lab LOCAL_LAB_ENABLED=true next dev --hostname 127.0.0.1 --port 3000",
    "start:local": "cross-env NEXT_PUBLIC_APP_MODE=local_lab LOCAL_LAB_ENABLED=true next start --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "mock-video:generate": "tsx scripts/generate-mock-video.ts",
    "verify:remote": "tsx scripts/verify-remote-setup.ts",
    "worker:mock": "tsx scripts/mock-video-worker.ts",
    "worker:mock:once": "cross-env MOCK_WORKER_ONCE=true tsx scripts/mock-video-worker.ts",
    "worker:mock:once:test": "tsx scripts/verify-worker-once.ts",
    "test:unit": "tsx scripts/unit-tests.ts",
    "test:integration": "tsx scripts/integration-test.ts",
    "test:gpu-worker-role": "tsx scripts/test-gpu-worker-role.ts",
    "test:cleanup": "tsx scripts/cleanup-test-residue.ts",
    "local-lab:setup": "tsx scripts/setup-local-lab-user.ts",
    "local-lab:reset": "tsx scripts/reset-local-lab.ts",
    "local-lab:reset:dry": "tsx scripts/reset-local-lab.ts",
    "local-lab:check": "tsx scripts/check-local-lab.ts",
    "local-lab:test": "tsx scripts/local-lab-tests.ts",
    "local-lab:delete:test": "tsx scripts/local-lab-delete-tests.ts",
    "gpu-worker:create-account": "tsx scripts/manage-gpu-worker-account.ts create",
    "gpu-worker:rotate-account": "tsx scripts/manage-gpu-worker-account.ts rotate",
    "gpu-worker:delete-account": "tsx scripts/manage-gpu-worker-account.ts delete",
    "gpu-worker:test": "tsx scripts/gpu-worker-check.ts",
    "gpu-worker:lint": "tsx scripts/gpu-worker-check.ts",
    "clore:find": "tsx scripts/clore/find-5090.ts",
    "clore:find:mock": "tsx scripts/clore/find-5090.ts --mock",
    "clore:wallet": "tsx scripts/clore/wallet-status.ts",
    "clore:create:dry": "tsx scripts/clore/create-order.ts",
    "clore:create": "tsx scripts/clore/create-order.ts",
    "clore:status": "tsx scripts/clore/order-status.ts",
    "clore:cancel": "tsx scripts/clore/cancel-order.ts",
    "clore:cancel:dry": "tsx scripts/clore/cancel-order.ts",
    "clore:test": "tsx scripts/clore/clore-tests.ts",
    "clore:execution:test": "tsx scripts/clore/execution-tests.ts",
    "clore:ssh:test": "tsx scripts/clore/ssh-tests.ts",
    "clore:session:plan": "tsx scripts/clore/session-orchestrator.ts plan",
    "clore:session:dry": "tsx scripts/clore/session-orchestrator.ts dry",
    "clore:session:status": "tsx scripts/clore/session-orchestrator.ts status",
    "clore:session:stop:dry": "tsx scripts/clore/session-orchestrator.ts stop:dry",
    "clore:session:test": "tsx scripts/clore/session-tests.ts",
    "first-gpu-session:plan": "tsx scripts/clore/first-gpu-session.ts",
    "first-gpu-session:test": "tsx scripts/clore/first-gpu-session-tests.ts",
    "runtime-image:check": "tsx scripts/runtime-image/check.ts",
    "runtime-image:plan": "tsx scripts/runtime-image/plan.ts",
    "runtime-image:test": "tsx scripts/runtime-image/runtime-image-tests.ts",
    "model-cache:plan": "tsx scripts/model-cache/plan-sync.ts",
    "model-cache:test": "tsx scripts/model-cache/model-cache-tests.ts",
    "model-cache:manifest:test": "tsx scripts/model-cache/verify.ts --mock",
    "model-cache:r2:test": "tsx scripts/model-cache/r2-credentials-check.ts",
    "model-cache:seed:test": "tsx scripts/model-cache/seed-cache.ts",
    "cost:session": "tsx scripts/cost/session-cost.ts",
    "cost:plan": "tsx scripts/cost/session-plan.ts",
    "cost:test": "tsx scripts/cost/cost-tests.ts",
    "results:sync": "tsx scripts/local-results/sync.ts",
    "results:check": "tsx scripts/local-results/verify.ts",
    "results:cleanup:dry": "tsx scripts/local-results/cleanup-remote.ts",
    "results:cleanup": "tsx scripts/local-results/cleanup-remote.ts",
    "results:test": "tsx scripts/local-results/local-results-tests.ts",
    "docker:check": "tsx scripts/dockerfile-check.ts",
    "secret:scan": "tsx scripts/secret-scan.ts",
    "check:clore-prep": "tsx scripts/clore/check-clore-prep.ts",
    "check:local-lab": "npm run local-lab:test && npm run local-lab:delete:test && npm run test:unit && npm run lint && npm run typecheck && npm run build && npm run secret:scan",
    "check:full": "npm run mock-video:generate && npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run verify:remote && npm run test:integration",
    "check:cost-optimized-gpu": "npm run model-cache:test && npm run runtime-image:test && npm run cost:test && npm run clore:session:test && npm run results:test",
    "check:first-gpu-session": "npm run model-cache:seed:test && npm run clore:execution:test && npm run clore:ssh:test && npm run first-gpu-session:test && npm run lint && npm run typecheck && npm run build && npm run secret:scan",
    "check:gpu-prep": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run gpu-worker:test && npm run clore:test && npm run clore:session:test && npm run runtime-image:test && npm run model-cache:test && npm run model-cache:seed:test && npm run cost:test && npm run results:test && npm run docker:check && npm run secret:scan"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.110.0"
  }
}
